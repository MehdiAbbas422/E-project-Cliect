# ---- Client environment (Vite) ----
# Copy this file to `.env.local` for local development, or set the same keys in
# your hosting provider's dashboard (e.g. Vercel -> Settings -> Environment
# Variables) before the production build.

# Base URL of the API server.
# Dev: leave UNSET — the Vite proxy forwards /api and /uploads to :5000.
# Prod: needed when the client and server are on different origins
#       (e.g. Vercel frontend + Render/Railway backend).
# VITE_API_URL=https://your-backend.onrender.com/api

# Base URL of the Socket.IO / API server (same host as VITE_API_URL, WITHOUT /api).
# Dev: leave UNSET — defaults to http://localhost:5000.
# Prod: required for real-time notifications to connect.
# VITE_SOCKET_URL=https://your-backend.onrender.com
